# .env.example
# Konfigurasi Lingkungan - AgroEWS

# Lingkungan & URL
NODE_ENV=development
APP_MOCK_DB=true
NEXT_PUBLIC_APP_URL=http://localhost:3000
AUTH_URL=http://localhost:3000

# Basis Data (PostgreSQL)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/agroews

# Autentikasi (Auth.js / NextAuth)
# Hasilkan kunci 32-byte acak: openssl rand -base64 32
AUTH_SECRET=changeme_auth_secret_minimum_32_characters_random

# Kunci Enkripsi PII (AES-256-GCM)
# Kunci hex 32-byte (64 karakter hex) untuk enkripsi nomor telepon dan data petani
PII_ENC_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
# ID kunci aktif untuk mendukung rotasi
PII_ENC_KEY_ID=v1

# Kunci Blind Index PII (HMAC-SHA256)
# Kunci hex 32-byte (64 karakter hex) untuk pencarian cepat nomor telepon di webhook
PII_HMAC_KEY=abcdef0123456789abcdef0123456789abcdef0123456789abcdef0123456789

# Keamanan Job & Webhook
# Secret untuk autentikasi endpoint cron internal (Bearer token)
CRON_SECRET=changeme_cron_secret_minimum_32_characters

# WhatsApp Business Cloud API
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=

# Telegram Bot API (Kanal Paralel)
TELEGRAM_BOT_TOKEN=
TELEGRAM_SECRET_TOKEN=
